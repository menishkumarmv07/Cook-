# Copy to .env.local for local development. Never commit real secrets.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKING_SESSION_SECRET=replace-with-at-least-32-random-characters
# Set a long, unique password locally and in encrypted deployment settings.
COOKING_OWNER_PASSWORD=replace-with-your-private-owner-password
